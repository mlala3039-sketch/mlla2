-- LOGIKA AUTO FAVORITE (MYTHICAL)
-- ==========================================
_G.FavoritedFish = _G.FavoritedFish or {}
local uuidPattern = "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x"

local function scanMemoryAndFavorite()
    if not autoFavEnabled or isScanningMemory then return end
    isScanningMemory = true
    
    local success, ToggleFavorite = pcall(function()
        local invSys = ReplicatedStorage:WaitForChild("InventorySystem", 2)
        if not invSys then return nil end
        local invRem = invSys:WaitForChild("InventoryRemotes", 2)
        if not invRem then return nil end
        return invRem:WaitForChild("ToggleFavorite", 2)
    end)
    
    if not success or not ToggleFavorite then 
        isScanningMemory = false
        return 
    end

    local tablesScanned = 0
    local gc = getgc(true)

    for _, tbl in pairs(gc) do
        if not autoFavEnabled then break end
        if type(tbl) == "table" then
            pcall(function()
                for k, v in pairs(tbl) do
                    if type(k) == "string" and string.match(k, uuidPattern) and type(v) == "table" then
                        for _, subV in pairs(v) do
                            if type(subV) == "string" and string.find(string.lower(subV), "mythical") then
                                if not _G.FavoritedFish[k] then
                                    _G.FavoritedFish[k] = true
                                    _G.IsScriptFavoriting = true
                                    ToggleFavorite:FireServer(k)
                                    _G.IsScriptFavoriting = false
                                    totalFavorited = totalFavorited + 1
                                    UpdateStats()
                                end
                                break
                            end
                        end
                    elseif type(v) == "string" and string.match(v, uuidPattern) then
                        for _, sibV in pairs(tbl) do
                            if type(sibV) == "string" and string.find(string.lower(sibV), "mythical") then
                                if not _G.FavoritedFish[v] then
                                    _G.FavoritedFish[v] = true
                                    _G.IsScriptFavoriting = true
                                    ToggleFavorite:FireServer(v)
                                    _G.IsScriptFavoriting = false
                                    totalFavorited = totalFavorited + 1
                                    UpdateStats()
                                end
                                break
                            end
                        end
                    end
                end
            end)
            tablesScanned = tablesScanned + 1
            if tablesScanned % 150 == 0 then task.wait() end
        end
    end
    isScanningMemory = false
end

TabFarm:CreateToggle({
