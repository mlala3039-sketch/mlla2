local function getNearestCrystal()
    local char = safeGetCharacter()
    if not char then return nil end

    local root = char.HumanoidRootPart
    local nearest = nil
    local minDist = math.huge

    for _, obj in ipairs(crystalCache) do
        if obj and obj.Parent then
            local pos = obj:GetPivot().Position
            if pos and not isPlayerNearby(pos) then
                local dist = (root.Position - pos).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = obj
                end
            end
        end
    end
    return nearest
end

local function resetCharacterState()
    local char = safeGetCharacter()
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if root then root.Anchored = false end
        if humanoid then humanoid.PlatformStand = false end
    end
end

local function lieDownUnderCrystal(crystal)
    local char = safeGetCharacter()
    if not char then return end
    
    local root = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    humanoid.PlatformStand = true
    
    local crystalCF, crystalSize
    if crystal:IsA("Model") then
        crystalCF, crystalSize = crystal:GetBoundingBox()
    else
        crystalCF = crystal.CFrame
        crystalSize = crystal.Size
    end
    
    local targetCF = crystalCF * CFrame.new(0, -(crystalSize.Y / 2) - jarakBawah, 0)
    
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = targetCF * CFrame.Angles(math.rad(90), 0, 0)
    
    task.wait(0.15)
    root.Anchored = true
    autoEquipPickaxe()
end

local function hitCrystal(crystal)
    if not miningEvent then return end
    pcall(function()
        miningEvent:FireServer("Hit", crystal)
        if crystal:IsA("Model") then
            for _, child in pairs(crystal:GetDescendants()) do
                if child:IsA("BasePart") then
                    miningEvent:FireServer("Hit", child)
                end
            end
        end
        miningEvent:FireServer("Hit")
    end)
end

-- ==========================================
-- LOGIKA UTAMA FARMING
-- ==========================================
local function startFarming()
    if farmThread then return end
    farmThread = task.spawn(function()
        
        while _G.AutoFarm do
            local char = safeGetCharacter()
            if not char then
                LocalPlayer.CharacterAdded:Wait()
                task.wait(1)
                continue
            end

            if currentCrystal and currentCrystal.Parent then
                if isPlayerNearby(currentCrystal:GetPivot().Position) then
                    currentCrystal = nil
                    hitCount = 0
                    resetCharacterState()
                end
            end

            local crystal = getNearestCrystal()
            if crystal and crystal.Parent then
                
                if currentCrystal ~= crystal then
                    currentCrystal = crystal
                    hitCount = 0
                    lieDownUnderCrystal(crystal)
                    task.wait(0.2)
                end
                
                char = safeGetCharacter()
                if char and char:FindFirstChild("HumanoidRootPart") and not char.HumanoidRootPart.Anchored then
                    lieDownUnderCrystal(crystal)
                end

                swingTool()
                hitCrystal(crystal)
                hitCount = hitCount + 1

                -- Cek jika tersangkut (>8 kali hit tanpa pecah)
                if autoRefOn6Hits and hitCount >= 8 then
                    if Notify then
                        Notify({Title = "Auto Ref", Content = "Karakter Nyangkut -> Executed ;ref", Duration = 2})
                    end
                    
                    hitCount = 0
                    currentCrystal = nil
                    resetCharacterState()
                    triggerRef()
                    
                    task.wait(2.5)
                    continue
                end
                
            else
                currentCrystal = nil
                hitCount = 0
                resetCharacterState()
            end
            
            task.wait(kecepatanHit)
        end
        
        currentCrystal = nil
        hitCount = 0
        setNoclip(false)
        resetCharacterState()
        farmThread = nil
    end)
end

