local function doAutoSellTask()
    isSelling = true
    local rootPart = getRootPart()
    
    if rootPart and savedPoint1 then rootPart.CFrame = savedPoint1 end
    task.wait(6)
    
    VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.2)
    VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)

    if rootPart then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local dist = (obj.Parent.Position - rootPart.Position).Magnitude
                if dist <= obj.MaxActivationDistance + 5 then
                    pcall(function() if fireproximityprompt then fireproximityprompt(obj) end end)
                end
            end
        end
    end

    task.wait(2)
    
    for _, gui in pairs(PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local text = gui:IsA("TextButton") and string.lower(gui.Text) or ""
            local name = string.lower(gui.Name)
            
            if string.find(text, "sell") or string.find(name, "sell") or string.find(text, "jual") then
                local absPos = gui.AbsolutePosition
                local absSize = gui.AbsoluteSize
                local center = absPos + (absSize / 2)
                
                for i = 1, 200 do
                    VIM:SendMouseButtonEvent(center.X, center.Y + 36, 0, true, game, 0)
                    task.wait(0.03)
                    VIM:SendMouseButtonEvent(center.X, center.Y + 36, 0, false, game, 0)
                    task.wait(0.03)
                end
                break
            end
        end
    end
    
    task.wait(1)
    
    if rootPart and savedPoint2 then rootPart.CFrame = savedPoint2 end
    task.wait(1)
    
    lastTapTime = 0
    isSelling = false
end

