-- ==========================================
-- HOOKING: DETEKSI UNFAVORITE MANUAL
-- ==========================================
local successHook, errorMsg = pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and tostring(self) == "ToggleFavorite" then
            if not _G.IsScriptFavoriting then
                local args = {...}
                local uuid = args[1]
                if uuid and type(uuid) == "string" and _G.FavoritedFish then
                    _G.FavoritedFish[uuid] = nil
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end)

if not successHook then
    warn("Executor kamu tidak mendukung Hooking, Auto Re-favorite manual mungkin tidak bekerja.")
end

