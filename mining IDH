local function autoEquipPickaxe()
    local char = safeGetCharacter()
    if not char then return nil end
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return nil end

    local function isBlacklisted(itemName)
        local name = string.lower(itemName)
        for _, bad in ipairs(blacklistKeywords) do
            if string.find(name, bad) then return true end
        end
        return false
    end

    local function isPickaxe(item)
        if not item:IsA("Tool") or isBlacklisted(item.Name) then return false end
        local name = string.lower(item.Name)
        for _, key in ipairs(pickaxeKeywords) do
            if string.find(name, key) then return true end
        end
        return false
    end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        if isPickaxe(currentTool) then
            return currentTool
        else
            humanoid:UnequipTools()
            task.wait(0.1)
        end
    end

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if isPickaxe(item) then
                humanoid:EquipTool(item)
                task.wait(0.1)
                return item
            end
        end
    end
    return nil
end

local function isPlayerNearby(pos)
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local pRoot = player.Character.HumanoidRootPart
            if (pRoot.Position - pos).Magnitude <= jarakAmanPemain then
                return true
            end
        end
    end
    return false
end

local function setNoclip(state)
    if state then
        if not noclipConn then
            noclipConn = RunService.Stepped:Connect(function()
                local char = safeGetCharacter()
                if char and _G.AutoFarm then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end
end

local function swingTool()
    local tool = autoEquipPickaxe()
    if tool then
        tool:Activate()
    end
end

local function checkPartColor(part)
    if not part:IsA("BasePart") then return false end
    local colorName = string.lower(part.BrickColor.Name)
    for _, w in ipairs(targetWarna) do
        if string.find(colorName, string.lower(w)) then return true end
    end
    local r, g, b = part.Color.R, part.Color.G, part.Color.B
    if r > 0.5 and g > 0.5 and b < 0.4 then return true end
    if r > 0.5 and g < 0.35 and b < 0.35 then return true end
    return false
end

local function isTargetColor(crystal)
    if not filterWarna then return true end
    if crystal:IsA("BasePart") then
        return checkPartColor(crystal)
    elseif crystal:IsA("Model") then
        for _, child in pairs(crystal:GetDescendants()) do
            if child:IsA("BasePart") and checkPartColor(child) then
                return true
            end
        end
    end
    return false
end

task.spawn(function()
    while true do
