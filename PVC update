local function setHoldState(shouldHold)
    if isCurrentlyHolding ~= shouldHold then
        isCurrentlyHolding = shouldHold
        VIM:SendMouseButtonEvent(500, 500, 0, shouldHold, game, 0)
    end
end

local function tapScreen()
    pcall(function()
        VIM:SendTouchEvent(0, Enum.UserInputState.Begin, Vector2.new(500, 500))
        task.wait(0.05)
        VIM:SendTouchEvent(0, Enum.UserInputState.End, Vector2.new(500, 500))
    end)
    pcall(function()
        VIM:SendMouseButtonEvent(500, 500, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(500, 500, 0, false, game, 0)
    end)
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(500, 500))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(500, 500))
    end)
end

TabFarm:CreateToggle({
   Name = "Auto Fish",
   CurrentValue = false,
   Flag = "AutoFish",
   Callback = function(Value)
        autoFishEnabled = Value
        if autoFishEnabled then
            lastTapTime = 0 
        else
            setHoldState(false)
        end
   end,
})

local function getMinigameData()
    if minigameTable and minigameTable.isGameActive ~= nil then
        return minigameTable
    end
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "isGameActive") ~= nil and rawget(v, "detecSize") ~= nil then
            minigameTable = v
            return minigameTable
        end
    end
    return nil
end

local timer = 0
RunService.RenderStepped:Connect(function(dt)
    if not autoFishEnabled then return end

    local data = getMinigameData()

    if data and data.isGameActive then
        wasMinigameActive = true
        if data.Detec and data.Attc then
            timer = timer + dt
            if timer < HOLD_DELAY then return end
            timer = 0

            local detecPos = data.Detec.Position.X.Scale + (data.detecSize / 2)
            local attcPos = data.Attc.Position.X.Scale + (data.attcSize / 2)

            if not isCurrentlyHolding and detecPos < (attcPos - LOWER_BUFFER) then
                setHoldState(true)
            elseif isCurrentlyHolding and detecPos > (attcPos + UPPER_BUFFER) then
                setHoldState(false)
            end
        end
    else
        if wasMinigameActive then
            totalCaught = totalCaught + 1
            UpdateStats()
            wasMinigameActive = false
            
            if autoSellEnabled then
                task.spawn(doAutoSellTask)
            end
        end

        if isSelling then return end

        setHoldState(false)
        if os.clock() - lastTapTime >= TAP_COOLDOWN then
            lastTapTime = os.clock()
            task.spawn(tapScreen)
        end
    end
end)
