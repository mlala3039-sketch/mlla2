-- LOGIKA ANTI-ADMIN / AUTO SERVER HOP
-- ==========================================
local SecurityOptions = { AntiAdminEnabled = false, GroupId = 0, MinStaffRank = 200, Keywords = {"admin", "mod", "staff", "owner", "dev", "creator", "tester"} }

local function ServerHop()
    Notify({Title = "🛡️ Keamanan Aktif", Content = "Mencari server baru yang aman...", Duration = 3})
    pcall(function()
        local serversData = game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100")
        local servers = HttpService:JSONDecode(serversData)
        if servers and servers.data then
            for _, v in ipairs(servers.data) do
                if type(v) == "table" and v.playing ~= nil and v.id ~= game.JobId then
                    if v.playing < (v.maxPlayers - 1) then TeleportService:TeleportToPlaceInstance(game.PlaceId, v.id, LocalPlayer); return end
                end
            end
        end
    end)
    task.wait(1.5)
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
end

local function isStaffMember(player)
    if player == LocalPlayer then return false, "" end
    local lowerName, lowerDisplay = string.lower(player.Name), string.lower(player.DisplayName)
    for _, word in ipairs(SecurityOptions.Keywords) do
        if string.find(lowerName, word) or string.find(lowerDisplay, word) then return true, "Name ("..word..")" end
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local rankObj = leaderstats:FindFirstChild("Rank") or leaderstats:FindFirstChild("Role") or leaderstats:FindFirstChild("GroupRank")
        if rankObj and rankObj:IsA("StringValue") then
            local lowerRole = string.lower(rankObj.Value)
            for _, word in ipairs(SecurityOptions.Keywords) do
                if string.find(lowerRole, word) then return true, "Rank ("..word..")" end
            end
        end
    end
    if SecurityOptions.GroupId > 0 then
        local s, r = pcall(function() return player:GetRankInGroup(SecurityOptions.GroupId) end)
        if s and r >= SecurityOptions.MinStaffRank then return true, "Group Rank ("..tostring(r)..")" end
    end
    return false, ""
end

local function executeSecurityAction(player, reason)
    _G.AutoFarm = false; setNoclip(false); resetCharacterState()
    Notify({Title = "⚠️ STAFF DETECTED ⚠️", Content = player.Name .. " bergabung! (" .. reason .. ")\nPindah server...", Duration = 5})
    task.wait(1); ServerHop()
end

Players.PlayerAdded:Connect(function(player)
    if SecurityOptions.AntiAdminEnabled then
        task.spawn(function()
            task.wait(2)
            local isStaff, reason = isStaffMember(player)
            if isStaff then executeSecurityAction(player, reason) end
        end)
    end
end)

