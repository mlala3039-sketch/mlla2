local function applyESP(model, color)
    if not model:IsA("Model") then return end
    
    local highlight = model:FindFirstChildOfClass("Highlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "CustomESP"
        highlight.FillColor = color or Color3.fromRGB(0, 255, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = model
    end

    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BillboardGui") then
            descendant.Enabled = true
            descendant.AlwaysOnTop = true
            descendant.MaxDistance = math.huge
        end
    end
end

local function removeESP()
    local containers = {workspace:FindFirstChild("Boulders"), workspace:FindFirstChild("PlotRunes"), workspace:FindFirstChild("DroppedRunes")}
    for _, folder in ipairs(containers) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("Highlight") and obj.Name == "CustomESP" then
                    obj:Destroy()
                end
            end
        end
    end
end

