local function formatCurrency(amount)
    if amount >= 1000000000 then
        return string.format("%.2fB", amount / 1000000000)
    elseif amount >= 1000000 then
        return string.format("%.1fM", amount / 1000000)
    elseif amount >= 1000 then
        return string.format("%.1fK", amount / 1000)
    end
    return tostring(amount)
end

local function getAllRockObjects()
    local rocks = {}
    local candidateContainers = {
        workspace:FindFirstChild("SpawnedGems"),
        workspace:FindFirstChild("Boulders"),
        workspace:FindFirstChild("Gems"),
        workspace:FindFirstChild("Ores"),
        workspace:FindFirstChild("Rocks"),
        workspace:FindFirstChild("Nodes")
    }
    
    for _, folder in ipairs(candidateContainers) do
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                table.insert(rocks, child)
            end
        end
    end
    
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            if child.Name:lower():find("gem") or child.Name:lower():find("rock") or child.Name:lower():find("boulder") or child.Name:lower():find("ore") then
                table.insert(rocks, child)
            end
        end
    end
    return rocks
end

local function getTargetPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        local m = obj:FindFirstChild("Mesh_0") or obj:FindFirstChild("Part") or obj:FindFirstChildOfClass("BasePart")
        if m then return m end
    end
    return nil
end

