    TLabel.Font = Enum.Font.Gotham
    TLabel.TextSize = 13
    TLabel.Parent = TFrame

    local TButton = Instance.new("TextButton")
    TButton.Size = UDim2.new(0, 44, 0, 22)
    TButton.Position = UDim2.new(1, -52, 0.5, -11)
    TButton.BackgroundColor3 = defaultState and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(40, 40, 40)
    TButton.Text = ""
    TButton.Parent = TFrame

    local TBC = Instance.new("UICorner")
    TBC.CornerRadius = UDim.new(1, 0)
    TBC.Parent = TButton

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 18, 0, 18)
    Indicator.Position = defaultState and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
    Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Indicator.Parent = TButton

    local IC = Instance.new("UICorner")
    IC.CornerRadius = UDim.new(1, 0)
    IC.Parent = Indicator

    local state = defaultState
    TButton.MouseButton1Click:Connect(function()
        state = not state
        TButton.BackgroundColor3 = state and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(40, 40, 40)
        Indicator:TweenPosition(state and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2), "Out", "Quad", 0.15, true)
        callback(state)
    end)
end

local function CreateButton(parentScroll, text, callback)
    local BFrame = Instance.new("Frame")
    BFrame.Size = UDim2.new(1, 0, 0, 36)
    BFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    BFrame.BackgroundTransparency = 0.4
    BFrame.Parent = parentScroll

    local BC = Instance.new("UICorner")
    BC.CornerRadius = UDim.new(0, 6)
    BC.Parent = BFrame

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, 0, 1, 0)
    Button.BackgroundTransparency = 1
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Font = Enum.Font.Gotham
    Button.TextSize = 13
    Button.Parent = BFrame

    Button.MouseButton1Click:Connect(function()
        pcall(callback)
    end)
end

