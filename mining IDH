local TabConfig = CreateTab("Config")
CreateSection(TabConfig, "Simpan Pengaturan")

local function SaveConfig()
    local success, _ = pcall(function()
        local data = {
            AutoFarm = Toggles.AutoFarm and Toggles.AutoFarm.Get() or false,
            FilterWarna = Toggles.FilterWarna and Toggles.FilterWarna.Get() or true,
            AntiAdmin = Toggles.AntiAdmin and Toggles.AntiAdmin.Get() or false,
            AntiAFK = Toggles.AntiAFK and Toggles.AntiAFK.Get() or true,
        }
        writefile(ConfigFile, HttpService:JSONEncode(data))
    end)
    if success then
        Notify({Title = "Config", Content = "Pengaturan berhasil disimpan!", Duration = 3})
    else
        Notify({Title = "Config Error", Content = "Gagal menyimpan", Duration = 3})
    end
end

local function LoadConfig(isAuto)
    if isfile(ConfigFile) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(ConfigFile))
        end)
        if success and type(result) == "table" then
            if result.AutoFarm ~= nil and Toggles.AutoFarm then Toggles.AutoFarm.Set(result.AutoFarm, true) end
            if result.FilterWarna ~= nil and Toggles.FilterWarna then Toggles.FilterWarna.Set(result.FilterWarna, true) end
            if result.AntiAdmin ~= nil and Toggles.AntiAdmin then Toggles.AntiAdmin.Set(result.AntiAdmin, true) end
            if result.AntiAFK ~= nil and Toggles.AntiAFK then Toggles.AntiAFK.Set(result.AntiAFK, true) end
            
            if not isAuto then Notify({Title = "Config", Content = "Pengaturan berhasil dimuat!", Duration = 3}) end
        else
            if not isAuto then Notify({Title = "Config Error", Content = "File Config corrupt atau rusak.", Duration = 3}) end
        end
    else
        if not isAuto then Notify({Title = "Config Error", Content = "File Config tidak ditemukan.", Duration = 3}) end
    end
end

CreateButton(TabConfig, "💾 Simpan Config (Save)", function() SaveConfig() end)
CreateButton(TabConfig, "📂 Muat Config (Load)", function() LoadConfig(false) end)
CreateButton(TabConfig, "🗑️ Hapus Config (Delete)", function()
    pcall(function() if isfile(ConfigFile) then delfile(ConfigFile) end end)
