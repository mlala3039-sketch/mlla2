            local newCache = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not string.find(string.lower(obj.Name), "sell") then
                    if string.find(string.lower(obj.Name), string.lower(keywordTarget)) then
                        if isTargetColor(obj) then
                            table.insert(newCache, obj)
                        end
