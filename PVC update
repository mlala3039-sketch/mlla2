-- LOGIKA MONEY MAGNET CACHING & LOOP
-- ==========================================
local function isInsidePlayerFast(obj)
    local ancestor = obj:FindFirstAncestorOfClass("Model")
    return ancestor and ancestor:FindFirstChild("Humanoid") ~= nil
end

local function isMoneyPart(obj)
    if not obj:IsA("BasePart") then return false end
    if isInsidePlayerFast(obj) then return false end
    
    local lname = string.lower(obj.Name)
    for _, kw in ipairs(moneyKeywords) do
        if string.find(lname, kw) then
            return true
        end
    end
    return false
end

-- Caching awal uang
task.spawn(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isMoneyPart(obj) then table.insert(moneyCache, obj) end
    end
end)

-- Menangkap uang baru
workspace.DescendantAdded:Connect(function(obj)
    task.delay(0.05, function()
        if isMoneyPart(obj) then table.insert(moneyCache, obj) end
    end)
end)

RunService.RenderStepped:Connect(function()
    if not magnetEnabled then return end
    
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp and #moneyCache > 0 then
        local batchSize = 20
        local processed = 0
        
        while processed < batchSize and #moneyCache > 0 do
            if magnetCurrentIndex > #moneyCache then magnetCurrentIndex = 1 end
            
            local obj = moneyCache[magnetCurrentIndex]
            
            if not obj or not obj.Parent or not obj:IsDescendantOf(workspace) then
                table.remove(moneyCache, magnetCurrentIndex)
            else
                local touch = obj:FindFirstChildOfClass("TouchTransmitter") or obj:FindFirstChild("TouchInterest")
                if touch and firetouchinterest then
                    firetouchinterest(hrp, obj, 0)
                    firetouchinterest(hrp, obj, 1)
                end
                
                if not obj.Anchored then obj.CFrame = hrp.CFrame end
                
                magnetCurrentIndex = magnetCurrentIndex + 1
                processed = processed + 1
            end
        end
    end
end)

