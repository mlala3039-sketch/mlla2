-- Fungsi Eksekusi (Equip + Click)
local function startLoop()
    task.spawn(function()
        while isRunning do
            local character = player.Character
            local backpack = player:FindFirstChild("Backpack")
            
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local tool = nil

                -- 1. Cari item di karakter
                for _, item in pairs(character:GetChildren()) do
                    if item:IsA("Tool") and string.find(string.lower(item.Name), "scrambler") then
                        tool = item
                        break
                    end
                end

                -- 2. Jika tidak ada, cari di Backpack
                if not tool and backpack then
                    for _, item in pairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and string.find(string.lower(item.Name), "scrambler") then
                            tool = item
                            break
                        end
                    end
                end

                -- 3. Eksekusi Equip & Activate
                if tool and humanoid then
                    if tool.Parent == backpack then
                        humanoid:EquipTool(tool)
                    end
                    
                    if tool.Parent == character then
                        tool:Activate()
                    end
                end
            end

            task.wait(0.1) 
        end
    end)
end

-- Logika Tombol Toggle
ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning

    if isRunning then
        ToggleBtn.Text = "Status: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        startLoop()
    else
        ToggleBtn.Text = "Status: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end

    saveConfig()
end)

-- Logika Tombol Exit
ExitBtn.MouseButton1Click:Connect(function()
    isRunning = false
    ScreenGui:Destroy()
end)

-- Auto Load Konfigurasi Saat Pertama Kali Dijalankan
local savedData = loadConfig()
if savedData and savedData.Enabled then
    isRunning = true
    ToggleBtn.Text = "Status: ON"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    startLoop()
end
