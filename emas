local function getCurrentCFrame()
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 2)
	return hrp and hrp.CFrame or nil
end

local function teleportTo(cframe)
	if not cframe then return end
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 2)
	if hrp then hrp.CFrame = cframe end
end

local function formatCFrame(cframe)
	if not cframe then return "Unset" end
	local pos = cframe.Position
	return string.format("%.0f,%.0f,%.0f", pos.X, pos.Y, pos.Z)
end

local function getEquippedPan()
	local character = LocalPlayer.Character
	if not character then return nil end
	local tool = character:FindFirstChildOfClass("Tool")
	if tool then return tool end
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then return item end
		end
	end
	return nil
end

local function getBackpackInfo()
	local currentCount = 0
	local bp1 = LocalPlayer:FindFirstChild("Backpack")
	local bp2 = LocalPlayer:FindFirstChild("BackpackTwo")
	
	if bp1 then
		for _, item in ipairs(bp1:GetChildren()) do
			if item:IsA("Tool") then currentCount = currentCount + 1 end
		end
	end
	if bp2 then
		for _, item in ipairs(bp2:GetChildren()) do
			if item:IsA("Tool") then currentCount = currentCount + 1 end
		end
	end
	return currentCount, TargetMaxSpace
end

local function getPanFillInfo()
	local panTool = getEquippedPan()
	local currentFill = 0
	local maxCapacity = 406

	if panTool then
		currentFill = panTool:GetAttribute("Fill") or panTool:GetAttribute("PanFill") or 0
		maxCapacity = panTool:GetAttribute("MaxFill") or panTool:GetAttribute("Capacity") or maxCapacity
	end

	pcall(function()
		for _, gui in ipairs(PlayerGui:GetChildren()) do
			if gui:IsA("ScreenGui") and gui.Name ~= "MicroAutoFarmGui" then
				local label = gui:FindFirstChild("FillText", true) or gui:FindFirstChild("PanFill", true)
				if label and label:IsA("TextLabel") and label.Text:match("(%d+)/(%d+)") then
					local cur, maxVal = label.Text:match("(%d+)/(%d+)")
					currentFill = tonumber(cur) or currentFill
					maxCapacity = tonumber(maxVal) or maxCapacity
					break
				end
			end
		end
	end)

	return currentFill, maxCapacity
end

local function ensureInGameAutoPanEnabled()
	if not AutoScanPanEnabled then return end
	pcall(function()
		local mainGui = PlayerGui:FindFirstChild("PanGui") or PlayerGui:FindFirstChild("Main") or PlayerGui:FindFirstChild("ScreenGui")
		if not mainGui then
			for _, gui in ipairs(PlayerGui:GetChildren()) do
				if gui:IsA("ScreenGui") and gui.Name ~= "MicroAutoFarmGui" then
					local btn = gui:FindFirstChild("AutoPan", true) or gui:FindFirstChild("Auto Pan", true)
					if btn then mainGui = gui break end
				end
			end
		end

		if mainGui then
			local autoPanBtn = mainGui:FindFirstChild("AutoPan", true) or mainGui:FindFirstChild("Auto Pan", true)
			if autoPanBtn and (autoPanBtn:IsA("GuiButton") or autoPanBtn:IsA("TextButton") or autoPanBtn:IsA("ImageButton")) then
				local bgColor = autoPanBtn.BackgroundColor3
				local isRed = (bgColor.R > 0.5 and bgColor.G < 0.4) or autoPanBtn:GetAttribute("Enabled") == false

				if isRed then
					if getconnections then
						for _, conn in ipairs(getconnections(autoPanBtn.MouseButton1Click)) do conn:Fire() end
						for _, conn in ipairs(getconnections(autoPanBtn.Activated)) do conn:Fire() end
					end
					local pos = autoPanBtn.AbsolutePosition
					local size = autoPanBtn.AbsoluteSize
					VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + 36, 0, true, game, 0)
					task.wait(0.05)
					VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + 36, 0, false, game, 0)
				end
			end
		end
	end)
end

local function forceResetTool()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if character then
		character:SetAttribute("Panning", nil)
		if humanoid then
			humanoid:UnequipTools()
			task.wait(0.1)
			local backpack = LocalPlayer:FindFirstChild("Backpack")
			if backpack then
				for _, item in ipairs(backpack:GetChildren()) do
					if item:IsA("Tool") then
						humanoid:EquipTool(item)
						break
					end
				end
			end
		end
	end
	lastActionTime = os.clock()
	lastFillChangeTime = os.clock()
	zeroFillStartTime = os.clock()
end

local function playSellSound(amount)
	if not ShopSounds then return end
	if amount > 1000000 then
		if ShopSounds:FindFirstChild("BigSell") then ShopSounds.BigSell:Play() end
	elseif amount > 100000 then
		if ShopSounds:FindFirstChild("MediumSell") then ShopSounds.MediumSell:Play() end
	elseif amount > 0 then
		if ShopSounds:FindFirstChild("SmallSell") then ShopSounds.SmallSell:Play() end
	else
		if ErrorSound then ErrorSound:Play() end
	end
end

local function sellItems()
	local success, earnings = pcall(function()
		return ShopRemote:InvokeServer()
	end)
	if success and typeof(earnings) == "number" then
		if earnings > 0 then playSellSound(earnings) end
		return earnings
	end
	return 0
end

local function triggerSellAllNow()
	if TPNPC_CFrame then teleportTo(TPNPC_CFrame) task.wait(0.15) end
	for i = 1, 3 do sellItems() task.wait(0.1) end
	task.wait(0.15)
	
	local currentFill, _ = getPanFillInfo()
	if currentFill > 0 then
		if TP2_CFrame then teleportTo(TP2_CFrame) end
	else
		if TP1_CFrame then teleportTo(TP1_CFrame) end
	end
	
	lastActionTime = os.clock()
	lastFillChangeTime = os.clock()
	zeroFillStartTime = os.clock()
end

-- =================================================================
-- 5. LOGIKA UTAMA LOOPING
-- =================================================================

local function runAutoLoop()
	if isRunning then return end
	isRunning = true

	task.spawn(function()
		while AutoPanEnabled or AutoSellEnabled or AutoScanPanEnabled do
			ensureInGameAutoPanEnabled()

			local character = LocalPlayer.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local itemCount, maxBackpackSpace = getBackpackInfo()

			if os.clock() - lastActionTime > 3 then
				isSellingInProcess = false
				forceResetTool()
			end

			if itemCount >= maxBackpackSpace and AutoSellEnabled and not isSellingInProcess then
				isSellingInProcess = true
				triggerSellAllNow()
				isSellingInProcess = false
			end

			if AutoPanEnabled and not isSellingInProcess and character and hrp then
				local panTool = getEquippedPan()
				if not panTool then
					forceResetTool()
					panTool = getEquippedPan()
				end

				if panTool then
					local scriptsFolder = panTool:FindFirstChild("Scripts") or panTool
					local collectRemote = scriptsFolder:FindFirstChild("Collect")
					local panRemote = scriptsFolder:FindFirstChild("Pan")
					local shakeRemote = scriptsFolder:FindFirstChild("Shake")

					local currentFill, maxCapacity = getPanFillInfo()
					local isPanning = character:GetAttribute("Panning")

					if currentFill ~= lastFillValue then
						lastFillValue = currentFill
						lastFillChangeTime = os.clock()
					end

					if currentFill == 0 then
						if os.clock() - zeroFillStartTime > 2.5 then
							isSellingInProcess = true
							triggerSellAllNow()
							isSellingInProcess = false
						end
					else
						zeroFillStartTime = os.clock()
					end

					local isFillStuck = (currentFill > 0) and (os.clock() - lastFillChangeTime > 1.5)

					if isFillStuck then
						isSellingInProcess = true
						triggerSellAllNow()
						isSellingInProcess = false

					elseif isPanning or currentFill >= maxCapacity then
						if TP2_CFrame then teleportTo(TP2_CFrame) end
						if not isPanning and panRemote then
							task.spawn(function() panRemote:InvokeServer() end)
							task.wait(0.1)
						end
						if shakeRemote then
							shakeRemote:FireServer()
							lastShakeTime = os.clock()
							lastActionTime = os.clock()
						end

					else
						if itemCount < maxBackpackSpace then
							if TP1_CFrame then teleportTo(TP1_CFrame) end
							if collectRemote then
								task.spawn(function() collectRemote:InvokeServer(3, false) end)
								lastActionTime = os.clock()
							end
						end
					end
				end
			end

			task.wait(0.01)
		end
		isRunning = false
	end)
end

