    local function UpdateVisuals(newState)
        TButton.BackgroundColor3 = newState and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(40, 40, 40)
        Indicator:TweenPosition(newState and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2), "Out", "Quad", 0.15, true)
    end

    local function SetState(newState, fireCallback)
        if state == newState then return end
        state = newState
        UpdateVisuals(state)
        if fireCallback ~= false then pcall(callback, state) end
    end

    TButton.MouseButton1Click:Connect(function() SetState(not state, true) end)
    UpdateVisuals(state)
    return { Set = SetState, Get = function() return state end }
end

